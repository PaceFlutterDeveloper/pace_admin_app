// Education Tab
class EducationTab extends StatelessWidget {
  final double width;
  final double height;

  const EducationTab({Key? key, required this.width, required this.height})
      : super(key: key);

  @override
  Widget build(BuildContext context) {
    final List<EducationRecord> educationList = [];

    return SingleChildScrollView(
      padding: EdgeInsets.all(width * 0.04),
      child: Column(
        children: [
          ElevatedButton.icon(
            onPressed: () {
              // Show add education dialog
            },
            icon: const Icon(Icons.add, color: Colors.white),
            label: const Text(
              'Add Education',
              style: TextStyle(color: Colors.white),
            ),
            style:
                ElevatedButton.styleFrom(backgroundColor: ConstColors.primary),
          ),
          const SizedBox(height: 20),
          if (educationList.isEmpty)
            const Center(child: Text('No education records added yet')),
        ],
      ),
    );
  }
}

